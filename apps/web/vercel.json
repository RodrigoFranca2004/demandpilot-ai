{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${API_ORIGIN}/$1",
      "env": ["API_ORIGIN"]
    },
    { "handle": "filesystem" }
  ]
}
